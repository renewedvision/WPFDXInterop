<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <id>RenewedVision.Wpf.Interop.DirectX</id>
        <title>RenewedVision.Wpf.Interop.DirectX</title>
        <version>$version$</version>
        <authors>Microsoft, RenewedVision</authors>
        <owners>Microsoft, NugetWPF, RenewedVision</owners>
        <copyright>© Microsoft Corporation. All rights reserved</copyright>
        <requireLicenseAcceptance>true</requireLicenseAcceptance>
        <license type="expression">MIT</license>
        <summary>RenewedVision.Wpf.Interop.DirectX provides a new implementation of D3DImage that enables you to seamlessly interop with DirectX 10 or 11 content in your WPF application.</summary>
        <projectUrl>https://github.com/renewedvision/WPFDXInterop</projectUrl>
        <tags>WPF DirectX D3DImage D3D11Image DirectX11 DirectX10 win-x86 win-x64</tags>
        <readme>docs\README.md</readme>
        <description>
            RenewedVision.Wpf.Interop.DirectX.D3D11Image is a version of D3DImage that supports DirectX 11 or DirectX 10 and includes win-x86 and win-x64 package assets. For more information, check out the project here: https://github.com/renewedvision/WPFDXInterop
        </description>   
        <dependencies>
            <group targetFramework="net472" />
            <group targetFramework="net8.0" />
            <group targetFramework="net9.0" />
            <group targetFramework="net10.0" />
        </dependencies>
    </metadata>
